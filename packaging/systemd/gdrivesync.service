# User service. Install to ~/.config/systemd/user/ and run:
#   systemctl --user enable --now gdrivesync
[Unit]
Description=Google Drive sync daemon
After=graphical-session.target network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/gdrivesync daemon
Restart=on-failure
RestartSec=30
# Logs go to the journal: journalctl --user -u gdrivesync -f

[Install]
WantedBy=default.target
